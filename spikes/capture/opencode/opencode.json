{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "permission": {
    "*": "deny",
    "todowrite": "allow",
    "task": "allow"
  },
  "agent": {
    "step-worker": {
      "description": "Performs the work of one plan step.",
      "mode": "subagent",
      "prompt": "Reply with the single word ok.",
      "permission": {
        "*": "deny"
      }
    }
  }
}
