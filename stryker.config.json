{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "core/src/**/*.ts",
    "!core/src/**/*.test.ts",
    "capture/shared/src/**/*.ts",
    "!capture/shared/src/**/*.test.ts",
    "capture/claude-code/src/**/*.ts",
    "!capture/claude-code/src/**/*.test.ts",
    "!capture/claude-code/src/**/hook.ts"
  ],
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
